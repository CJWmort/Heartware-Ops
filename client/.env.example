# Copy to .env  (never commit .env)

# Where the API lives.
#   Local development: leave as /api (Vite forwards it to http://localhost:8000)
#   Deployed (Vercel): set to your Render URL, e.g. https://heartware-api.onrender.com/api
VITE_API_BASE_URL=/api

# Socket.IO server (bonus). Leave empty locally to use the Vite proxy.
VITE_SOCKET_URL=
