# Copy to .env  (never commit .env)

# Socket.IO server (live chat and incident alerts).
# Leave EMPTY, both locally (the Vite proxy handles it) and on Vercel (the /socket.io rewrite in vercel.json handles it).
# Setting it to the backend address sends the browser straight to the backend, which does not receive the login
# cookie, so live updates would stop working.
VITE_SOCKET_URL=
