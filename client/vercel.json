{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://heartware-ops.onrender.com/api/:path*" },
    {
      "source": "/socket.io/:path*",
      "destination": "https://heartware-ops.onrender.com/socket.io/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
