# Copy to config.env and fill in. NEVER commit config.env.

# MongoDB Atlas connection string
DB=
# Long random text used to sign login sessions. Make a new one for the deployed site:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET=

# OneMap (address lookup): https://www.onemap.gov.sg/apidocs/docs/tokenmanagement
ONEMAP_API_EMAIL=
ONEMAP_API_PASSWORD=
ONEMAP_BASE_URL=https://www.onemap.gov.sg

# Sign-up code emails (Brevo). Leave BREVO_API_KEY empty locally: the 6-digit code then shows on the page (test mode).
# The deployed site NEEDS a real key, or nobody can register.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Heartware

# Set these on Render only, not in this file: NODE_ENV=production, NODE_VERSION=22
