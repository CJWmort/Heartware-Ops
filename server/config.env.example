# Copy this file to config.env and fill in the values. NEVER commit config.env.

# MongoDB Atlas connection string (ask Hanafi / group chat)
DB=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/heartware?retryWrites=true&w=majority

# Any long random string – used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

PORT=8000

# Comma-separated list of frontend URLs allowed to call this API (add the Vercel URL when deployed)
CLIENT_ORIGINS=http://localhost:5173,http://localhost:4173

# data.gov.sg "General information of schools" resource id (check the dataset page)
SCHOOLS_RESOURCE_ID=
